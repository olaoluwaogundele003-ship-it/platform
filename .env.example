# Platform API key + model config (AI-assisted compilation & agents)
# The key below was supplied for this build. Override via real env vars in production.
PLATFORM_AI_KEY=YOUR_PLATFORM_AI_KEY
PLATFORM_AI_BASE_URL=https://openrouter.ai/api/v1,https://api.openai.com/v1
PLATFORM_AI_MODEL=openai/gpt-4o-mini
